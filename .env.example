# Signs session cookies. REQUIRED in production — the app refuses to start
# without it there. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Returns magic-link and password-reset tokens in the API response so the
# flows are usable without a mail transport. MUST be false in production:
# otherwise anyone could request a link for any address and read it back.
AUTH_EXPOSE_MAGIC_LINK=true

# Storage. `json-file` snapshots to disk; `memory` is ephemeral.
STORAGE_DRIVER=json-file
STORAGE_FILE=.data/boatbooker.json

# Seed the deterministic fixture generator. Change for a different but still
# reproducible dataset.
SEED_VALUE=20260830

# White-label overrides (see src/config/brand.ts for the full set).
NEXT_PUBLIC_BRAND_NAME=BoatBooker
NEXT_PUBLIC_BRAND_LEGAL_NAME=BoatBooker, Inc.
NEXT_PUBLIC_BRAND_DOMAIN=boatbooker.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@boatbooker.com
NEXT_PUBLIC_SUPPORT_PHONE=+1 (833) 800-2628
