{
  "name": "boatbooker-rebuild",
  "version": "1.0.0",
  "private": true,
  "description": "Modular, full-stack rebuild of the BoatBooker marketplace \u2014 customer web + mobile app shell, owner dashboard, and REST backend.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "verify": "npm run typecheck && npm run check:i18n && npm run build",
    "tour": "node scripts/mobile-tour.js"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
